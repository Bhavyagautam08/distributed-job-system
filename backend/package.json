{
  "name": "distributed-job-system",
  "version": "1.0.0",
  "description": "Full-stack distributed job-processing platform with a Node.js API, PostgreSQL outbox, Redis Streams, background workers, retries, and a real-time React dashboard",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "dev": "nodemon server.js",
    "start": "node server.js",
    "worker": "node src/workers/worker.js",
    "bench:api": "node benchmarks/api-health.js",
    "bench:jobs": "node benchmarks/jobs-autocannon.js",
    "bench:matrix": "node benchmarks/matrix-runner.js",
    "bench:scale": "node benchmarks/worker-scaling.benchmark.js",
    "workers:start": "node benchmarks/start-worker-pool.js",
    "workers:report": "node benchmarks/collect-workers-report.js",
    "test": "node --test --test-concurrency=1",
    "test:concurrency": "node --test tests/concurrency-and-resilience.test.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.39.0",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "ioredis": "^5.8.2",
    "pg": "^8.16.3",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "autocannon": "^8.0.0",
    "nodemon": "^3.1.14"
  }
}
